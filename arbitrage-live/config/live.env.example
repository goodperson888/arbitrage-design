# 复制到当前 shell 的 export 命令中；不要把真实值写回仓库。
export LIVE_MODE=live
export LIVE_TRANSPORT_ENABLED=1
export LIVE_TRADING_ENABLE=1
export POLYMARKET_ORDER_ENABLED=1
export POLYMARKET_PREFLIGHT_APPROVED=1
export POLYMARKET_PRIVATE_KEY='<Polygon 钱包私钥，仅放在临时终端环境>'

# 只读行情开关（不会发订单）
export POLYMARKET_READONLY_NETWORK_ENABLED=1
export BINANCE_READONLY_NETWORK_ENABLED=1

# 可选：网络代理、预派生 L2 凭据；没有时官方 SDK 会用 L1 私钥派生。
